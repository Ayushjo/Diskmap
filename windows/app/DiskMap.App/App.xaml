<Application x:Class="DiskMap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Palette: colors are swapped in place by Theme.Apply(); controls
             reference them via DynamicResource (XAML) or Ui.Brush (code). -->
        <SolidColorBrush x:Key="AppBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AppSidebar" Color="#FFF5F6F7" />
        <SolidColorBrush x:Key="AppCard" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AppCardBorder" Color="#FFE7E7EA" />
        <SolidColorBrush x:Key="AppField" Color="#FFF1F2F4" />
        <SolidColorBrush x:Key="AppHover" Color="#FFF0F2F5" />
        <SolidColorBrush x:Key="AppForeground" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="AppSubtle" Color="#FF6E6E73" />
        <SolidColorBrush x:Key="AppFaint" Color="#FF9CA3AF" />
        <SolidColorBrush x:Key="AppAccent" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AppAccentSoft" Color="#FFEAF1FE" />
        <SolidColorBrush x:Key="AppNavSelected" Color="#FFE8ECF3" />
        <SolidColorBrush x:Key="AppRowSelected" Color="#FFEFF4FE" />
        <SolidColorBrush x:Key="AppDanger" Color="#FFDC2626" />
        <SolidColorBrush x:Key="AppDangerBg" Color="#FFFDECEC" />
        <SolidColorBrush x:Key="AppSuccess" Color="#FF16A34A" />
        <SolidColorBrush x:Key="AppSuccessBg" Color="#FFE8F6EE" />
        <SolidColorBrush x:Key="AppWarning" Color="#FFB45309" />
        <SolidColorBrush x:Key="AppWarningBg" Color="#FFFEF3DE" />
        <SolidColorBrush x:Key="AppInfoBg" Color="#FFEEF4FE" />
        <SolidColorBrush x:Key="AppInkButton" Color="#FF1D1D1F" />
        <SolidColorBrush x:Key="AppInkButtonFg" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AppBarTrack" Color="#FFECECF0" />
        <SolidColorBrush x:Key="AppPanel" Color="#FFF5F6F7" />
        <SolidColorBrush x:Key="AppBorder" Color="#FFE7E7EA" />
        <SolidColorBrush x:Key="AppChrome" Color="#FFFFFFFF" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppHover}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppChrome}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
            <Setter Property="Background" Value="{DynamicResource AppChrome}" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource AppPanel}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource AppPanel}" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>
    </Application.Resources>
</Application>
