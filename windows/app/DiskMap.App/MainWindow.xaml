<Window x:Class="DiskMap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DiskMap" Height="720" Width="1100" MinHeight="400" MinWidth="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: same page list as the macOS NavigationSplitView sidebar. -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0"
                Background="{DynamicResource AppPanel}">
            <DockPanel>
                <Button x:Name="ScanButton" DockPanel.Dock="Top" Margin="10,10,10,6" Padding="8,7"
                        Content="Scan Folder…" FontWeight="SemiBold" />
                <TextBlock x:Name="ScanStatus" DockPanel.Dock="Bottom" Margin="10,4,10,10"
                           TextWrapping="Wrap" Foreground="{DynamicResource AppSubtle}" FontSize="11" />
                <ListBox x:Name="NavList" DockPanel.Dock="Top" BorderThickness="0"
                         Background="Transparent" Margin="6,2,6,0"
                         SelectionMode="Single" />
            </DockPanel>
        </Border>

        <!-- Detail: header chrome + page host. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="12,8"
                    Background="{DynamicResource AppChrome}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Size:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="BasisToggle" Width="110" SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem Content="On disk" />
                            <ComboBoxItem Content="Logical" />
                        </ComboBox>
                        <Button x:Name="ResetZoom" Content="Top" Margin="8,0,0,0" Padding="8,4" />
                    </StackPanel>
                    <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" />

            <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Padding="12,4"
                    Background="{DynamicResource AppChrome}">
                <TextBlock x:Name="StatusBar" Foreground="{DynamicResource AppSubtle}" FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</Window>
