<Window x:Class="DiskMap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="freedisk.space" Height="780" Width="1280" MinHeight="600" MinWidth="880"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: logo, grouped nav, drive card. -->
        <Border x:Name="SidebarBorder" Grid.Column="0"
                BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="0,0,1,0"
                Background="{DynamicResource AppSidebar}" Panel.ZIndex="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="18,16,18,14">
                    <Border x:Name="LogoTile" Width="32" Height="32" DockPanel.Dock="Left" />
                    <TextBlock Text="freedisk.space" FontSize="14" FontWeight="Bold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="10,0,10,0" />
                </ScrollViewer>

                <!-- The scanned drive; click to scan another folder (Ctrl+O). -->
                <Border x:Name="DriveCard" Grid.Row="2" Margin="12,0,12,12" Padding="6,12,6,0"
                        Background="Transparent" Cursor="Hand"
                        ToolTip="Scan another folder or drive… (Ctrl+O)"
                        MouseLeftButtonUp="DriveCard_Click"
                        BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <ContentControl x:Name="DriveIcon" DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <TextBlock x:Name="DriveName" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ContentControl x:Name="DriveBar" />
                        <TextBlock x:Name="DriveStats" FontSize="11" Margin="0,6,0,0"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource AppSubtle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right side: top bar over content + inspector. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="0,0,0,1"
                    Padding="8,6" Background="{DynamicResource AppBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ContentControl x:Name="SidebarButtonHost" Margin="0,0,4,0" />
                    </StackPanel>
                    <ContentControl x:Name="SearchHost" Grid.Column="1" Margin="12,0,0,0"
                                    HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ContentControl x:Name="AppearanceButtonHost" Margin="0,0,4,0" />
                        <ContentControl x:Name="InspectorButtonHost" Margin="0,0,8,0" />
                        <ContentControl x:Name="CleanupButtonHost" />
                        <ContentControl x:Name="RescanButtonHost" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live scan strip: items found, rate, current folder, cancel. -->
            <Border x:Name="ScanBanner" Grid.Row="1" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="0,0,0,1"
                    Padding="16,6" Background="{DynamicResource AppBackground}">
                <DockPanel>
                    <ContentControl x:Name="ScanCancelHost" DockPanel.Dock="Right" />
                    <ContentControl x:Name="ScanDustyHost" DockPanel.Dock="Right" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ScanBannerText" FontSize="11.5"
                                   Foreground="{DynamicResource AppSubtle}" />
                        <ItemsControl x:Name="ScanTopLevels" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="290" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="PageHost" Grid.Column="0" />
                <Border x:Name="InspectorBorder" Grid.Column="1"
                        BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1,0,0,0"
                        Background="{DynamicResource AppBackground}" Panel.ZIndex="5">
                    <ContentControl x:Name="InspectorHost" />
                </Border>
            </Grid>
        </Grid>

        <!-- WIN-063: transient confirmations — stage / commit / put-back. -->
        <Border x:Name="ToastHost" Grid.ColumnSpan="2" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0"
                Background="{DynamicResource AppCard}" CornerRadius="17"
                BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1"
                Padding="14,8" Panel.ZIndex="10">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource AppForeground}" FontSize="13"
                       FontWeight="Medium" />
        </Border>
    </Grid>
</Window>
