<Window x:Class="DiskMap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DiskMap" Height="780" Width="1280" MinHeight="500" MinWidth="900"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: logo, grouped nav, drive card. -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="0,0,1,0"
                Background="{DynamicResource AppSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="16,18,16,10">
                    <Border x:Name="LogoTile" Width="32" Height="32" CornerRadius="8" DockPanel.Dock="Left" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DiskMap" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Understand your storage." FontSize="11"
                                   Foreground="{DynamicResource AppSubtle}" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="10,0,10,0" />
                </ScrollViewer>

                <Border Grid.Row="2" Margin="12" Padding="10"
                        Background="{DynamicResource AppCard}"
                        BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <ContentControl x:Name="DriveIcon" DockPanel.Dock="Left" Margin="0,0,8,0" />
                            <TextBlock x:Name="DriveName" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ContentControl x:Name="DriveBar" />
                        <TextBlock x:Name="DriveStats" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AppSubtle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right side: top bar over content + inspector. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="0,0,0,1"
                    Padding="16,10" Background="{DynamicResource AppBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- WIN-056: window menu — File / Go, the macOS menu bar's duties. -->
                    <Button x:Name="MenuButton" Grid.Column="0" Content="☰  DiskMap"
                            HorizontalAlignment="Left" Padding="10,5" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" FontSize="12.5"
                            Click="MenuButton_Click" />
                    <ContentControl x:Name="SearchHost" Grid.Column="1" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ContentControl x:Name="CleanupButtonHost" />
                        <ContentControl x:Name="RescanButtonHost" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live scan strip: items found, rate, current folder, cancel. -->
            <Border x:Name="ScanBanner" Grid.Row="1" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="0,0,0,1"
                    Padding="16,6" Background="{DynamicResource AppInfoBg}">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ScanBannerText" FontSize="11.5"
                                   Foreground="{DynamicResource AppSubtle}" />
                        <ItemsControl x:Name="ScanTopLevels" Margin="0,4,0,0" />
                    </StackPanel>
                    <ContentControl x:Name="ScanCancelHost" DockPanel.Dock="Right" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="296" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="PageHost" Grid.Column="0" />
                <Border Grid.Column="1" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1,0,0,0"
                        Background="{DynamicResource AppBackground}">
                    <ContentControl x:Name="InspectorHost" />
                </Border>
            </Grid>
        </Grid>

        <!-- WIN-063: transient confirmations — stage / commit / put-back. -->
        <Border x:Name="ToastHost" Grid.ColumnSpan="2" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0"
                Background="{DynamicResource AppForeground}" CornerRadius="8"
                Padding="14,8" Panel.ZIndex="10"
                Effect="{x:Null}">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource AppCard}" FontSize="12.5" />
        </Border>
    </Grid>
</Window>
