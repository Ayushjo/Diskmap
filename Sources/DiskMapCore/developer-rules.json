  "_rebuildCost": "free: regenerated automatically and offline the next time the tool runs. cheap: an offline rebuild (CPU time). networked: re-downloaded from a registry or vendor. A dependency folder whose project has no lockfile is reported as networked-unpinned: reinstalling may not reproduce what you have.",
  "manifests": {
    "_comment": "A folder containing one of these is a project root (TASK-051).",
    "names": [
      "package.json",
      "Cargo.toml",
      "go.mod",
      "pyproject.toml",
      "setup.py",
      "Pipfile",
      "requirements.txt",
      "Package.swift",
      "Podfile",
      "pubspec.yaml",
      "pom.xml",
      "build.gradle",
      "build.gradle.kts",
      "settings.gradle",
      "settings.gradle.kts",
      "Gemfile",
      "composer.json",
      "mix.exs",
      "deno.json",
      "CMakeLists.txt"
    ],
    "suffixes": [
      ".xcodeproj",
      ".xcworkspace"
    ]
  },
  "lockfiles": {
    "_comment": "Searched in the project root and every folder above it up to the repository root, because workspace managers keep one lockfile at the top. requirements.txt counts for Python: it is usually pinned, and a missed warning costs less than a false one (AGENTS.md: bias toward fewer false positives).",
    "node": [
      "package-lock.json",
      "npm-shrinkwrap.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "bun.lockb",
      "bun.lock"
    ],
    "cocoapods": [
      "Podfile.lock"
    ],
    "python": [
      "poetry.lock",
      "uv.lock",
      "Pipfile.lock",
      "pdm.lock",
      "requirements.txt"
    ]
  }
