 "notes": {
  "docker": {
   "note": "This is Docker's whole virtual disk: every image, container and volume lives inside it. Moving it to the Trash breaks Docker until it rebuilds an empty one.",
   "instead": "Run `docker system prune -a` (and `docker volume prune`), or Docker Desktop → Troubleshoot → Clean / Purge data."
  },
  "orbstack": {
   "note": "OrbStack's machines and containers live here. Moving it to the Trash deletes them.",
   "instead": "Delete machines with `orb delete <machine>`, or prune images in OrbStack's settings."
  },
  "vm": {
   "note": "This is a virtual machine's disk. Moving it to the Trash deletes the whole machine and everything inside it.",
   "instead": "Delete the virtual machine from the app that runs it (UTM, Parallels, VMware, VirtualBox)."
  },
  "avd": {
   "note": "Android emulator images. Moving them deletes the emulators.",
   "instead": "Delete emulators in Android Studio → Device Manager."
  },
  "archives": {
   "note": "Xcode archives hold your shipped builds and their debug symbols (dSYMs). Without them you can't symbolicate crash reports or re-upload those builds.",
   "instead": "Delete old archives in Xcode → Window → Organizer."
  },
  "app": {
   "note": "This is an installed app. Moving it to the Trash uninstalls it; its settings and data stay behind in your Library.",
   "instead": "Use Applications in freedisk.space, which also finds the app's related data, or drag it to the Trash in Finder."
  },
  "browser": {
   "note": "This is a browser profile: history, saved logins, bookmarks and extensions. Moving it to the Trash signs you out and loses them.",
   "instead": "Clear cached data in the browser's own settings (Settings → Privacy → Clear browsing data)."
  },
  "git": {
   "note": "This is a repository's history. Anything not pushed is lost with it.",
   "instead": "Run `git gc --aggressive --prune=now` to shrink it, or remove the whole project if you no longer need it."
  },
  "icloud": {
   "note": "This is iCloud Drive. Moving files from here to the Trash deletes them from iCloud on every device.",
   "instead": "Remove files in Finder → iCloud Drive, or turn on Optimize Mac Storage in System Settings → Apple Account → iCloud."
  },
  "system": {
   "note": "macOS manages this. Removing it can break the system or simply comes back.",
   "instead": "Use System Settings → General → Storage to review what macOS can remove."
  },
  "game": {
   "note": "Installed games. Moving them to the Trash breaks the launcher's library.",
   "instead": "Uninstall from the game launcher (Steam → Manage → Uninstall)."
  },
  "redownload": {
   "note": "Model files are large downloads; removing them means downloading them again.",
   "instead": null
  },
  "ollama": {
   "note": "Ollama's downloaded models. Removing them means downloading them again.",
   "instead": "Run `ollama list`, then `ollama rm <model>` for the ones you don't use."
  },
  "huggingface": {
   "note": "Hugging Face's model cache. Removing it means downloading models again.",
   "instead": "Run `huggingface-cli delete-cache` to pick which models to remove."
  }
 },
